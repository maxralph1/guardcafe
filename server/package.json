{
  "name": "guardcafe-server",
  "version": "0.0.1",
  "description": "GuardCafe is an application for security outfit managenent -- This is the server-side",
  "license": "ISC",
  "author": "Maximillian Raphaels",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node --env-file=.env src/index.js",
    "build": "echo \"no build needed\"",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "test:database": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --config jest.database.config.js",
    "test:unit": "npm test -- src/tests/unit", 
    "test:feature": "npm test -- src/tests/feature",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "check": "npm run lint && npm run format:check && npm test",
    "db:migrate": "node src/commands/database/migrate.js",
    "db:rollback": "node src/commands/database/migrate.js --rollback",
    "db:status": "node src/commands/database/migrate.js --status",
    "db:fresh": "node src/commands/database/migrate.js --fresh",
    "db:seed": "node src/commands/database/seed.js",
    "db:migrate-seed": "npm run db:migrate && npm run db:seed",
    "migration:generate": "typeorm migration:generate -o --esm -d src/config/database.js",
    "migration:generate-no-esm": "typeorm migration:generate -d src/config/database.js",
    "migration:run": "typeorm migration:run -d src/config/database.js",
    "migration:revert": "typeorm migration:revert -d src/config/database.js",
    "migration:show": "typeorm migration:show -d src/config/database.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
